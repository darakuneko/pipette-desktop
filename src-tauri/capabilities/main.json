{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions of the main window: the raw HID commands, the probe handle, the definition decompression and the app config the vialAPI shim calls.",
  "windows": ["main"],
  "permissions": [
    "allow-list-devices",
    "allow-open-device",
    "allow-close-device",
    "allow-send-receive",
    "allow-send",
    "allow-is-device-open",
    "allow-hid-probe-open",
    "allow-hid-probe-send-receive",
    "allow-hid-probe-close",
    "allow-decompress-definition",
    "allow-app-config-get-all",
    "allow-app-config-set"
  ]
}
