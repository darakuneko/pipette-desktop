{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions of the main window's own pages: one permission set per domain (permissions/<domain>.toml), together every app command, and listening to the events the backend emits.",
  "windows": ["main"],
  "permissions": [
    "hid",
    "definition",
    "app-config",
    "shell",
    "window",
    "sync-pending",
    "files",
    "keyboard-data",
    "favorites",
    "key-labels",
    "typing-texts",
    "snapshots",
    "analyze-filters",
    "run-logs",
    "typing-analytics-keymaps",
    "settings",
    "typing-datasets",
    "i18n-packs",
    "theme-packs",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
