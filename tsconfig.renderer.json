{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // Explicit: renderer test files (`node:fs`, `Buffer`, `__dirname`,
    // ...) need @types/node's ambient globals, and TypeScript does not
    // auto-include @types/node for this program.
    "types": ["node"]
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/tauri-shim/**/*"]
}
