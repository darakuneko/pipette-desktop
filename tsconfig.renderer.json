{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // Explicit like tsconfig.main.json's "types": ["node"] — renderer test
    // files (`node:fs`, `Buffer`, `__dirname`, ...) previously relied on
    // TypeScript's implicit @types auto-inclusion to see @types/node's
    // ambient globals. The vitest 3 -> 4 upgrade changed vitest's own
    // dependency graph enough that TS silently stopped auto-including
    // @types/node for this program, so it's declared explicitly instead
    // of depending on that implicit behavior again.
    "types": ["node"]
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"]
}
