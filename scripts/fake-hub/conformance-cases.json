        { "request": "PUT /api/key-labels/{labels}", "auth": "alice", "json": { "name": "x", "map": {} }, "expect": { "status": 404, "json": { "ok": false, "error": "Key label not found" } } }
      ]
    },
    {
      "name": "built-in key labels and records made directly",
      "localHub": false,
      "steps": [
        { "request": "POST /api/auth/token", "json": { "id_token": "test:alice@example.com" }, "expect": { "status": 200 }, "save": { "alice": "data.token" } },
        { "control": "keyLabel", "owner": "system", "name": "QWERTY", "map": { "KC_A": "A" }, "save": "builtIn" },
        { "request": "GET /api/key-labels/{builtIn}", "expect": { "status": 200, "json": { "ok": true, "data": { "name": "QWERTY", "uploaded_by": "00000000-0000-0000-0000-000000000001", "uploader_name": "pipette" } } }, "save": { "builtInUpdated": "data.updated_at" } },
        { "request": "PUT /api/key-labels/{builtIn}", "auth": "alice", "json": { "name": "QWERTY", "map": {} },
          "expect": { "status": 403, "json": { "ok": false, "error": "System-seeded key labels cannot be modified" } } },
        { "request": "DELETE /api/key-labels/{builtIn}", "auth": "alice",
          "expect": { "status": 403, "json": { "ok": false, "error": "System-seeded key labels cannot be deleted" } } },
        { "control": "touch", "kind": "keyLabel", "id": "{builtIn}" },
        { "request": "POST /api/key-labels/timestamps", "json": { "ids": ["{builtIn}"] },
          "expect": { "status": 200, "json": { "ok": true, "data": { "items": [{ "id": "$saved:builtIn", "updated_at": "$after:builtInUpdated" }] } } } }
      ]
    }
  ]
