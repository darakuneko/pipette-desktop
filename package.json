{
  "name": "pipette-desktop",
  "version": "0.5.0",
  "description": "Pipette — Vial-compatible keyboard configurator built with Tauri and TypeScript",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "author": "darakuneko <tvkids@gmail.com>",
  "homepage": "https://github.com/darakuneko/pipette-desktop",
  "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11",
  "scripts": {
    "dev": "tauri dev --features dev-tools",
    "typecheck": "tsc -p tsconfig.renderer.json && tsc -p tsconfig.scripts.json && tsc -p e2e-tauri/tsconfig.json",
    "build": "tauri build",
    "build:debug": "tauri build --debug --no-bundle --features dev-tools",
    "lint": "eslint src/ scripts/ e2e-tauri/",
    "lint:tdz": "npx tsx scripts/check-hook-deps-tdz.ts",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wdio run e2e-tauri/wdio.conf.ts",
    "generate:language-manifest": "tsx scripts/generate-language-manifest.ts",
    "generate:tray-template-icon": "tsx scripts/generate-tray-template-icon.ts",
    "generate:node-identity": "tsx scripts/node-identity/record-node-identity.ts",
    "test:fake-drive": "vitest run --config scripts/fake-drive/vitest.config.ts",
    "test:fake-hub": "vitest run --config scripts/fake-hub/vitest.config.ts",
    "test:fake-notification": "vitest run --config scripts/fake-notification/vitest.config.ts",
    "test:fake-update": "vitest run --config scripts/fake-update/vitest.config.ts",
    "test:update-manifest": "vitest run --config scripts/update-manifest/vitest.config.ts",
    "doc:screenshots": "wdio run e2e-tauri/doc-capture/wdio.conf.ts",
    "doc:guide": "node docs/build-guide.mjs"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/types": "9.32.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.8.0",
    "i18next": "^26.3.6",
    "jsdom": "^30.0.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "mermaid": "11.17.2",
    "node-machine-id": "^1.1.12",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
