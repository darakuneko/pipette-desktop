{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  // contract-types.ts compares the declarations generated from the Rust
  // backend with types of all three trees, src/main among them, so it is
  // checked here and left out of tsconfig.renderer.json.
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "src/preload/**/*",
    "src/tauri-shim/__tests__/contract-types.ts"
  ]
}
